# 银行ATM
money = 1000
name = input("请输入你的姓名：")
if name == "张三":
    money = 500
elif name == "李四":
    money = 1000
elif name == "王五":
    money = 3000
def menu():
    print("欢迎来到本银行！选择您的操作：")
    print("查询金额\t[输入1]")
    print("存款\t\t[输入2]")
    print("取款\t\t[输入3]")
    print("退出\t\t[输入4]")
    req = int(input("请输入您要办理的业务："))
    if req == 1:
        print(deposit())
    elif req == 2:
        print(enter())
    elif req == 3:
        print(out())
    elif req == 4:
        print("退出成功！")
    else:
        print("您输入错误！")
def deposit():
    print(f"您的银行卡余额剩余{money}元")
    return menu()
def enter():
    x = float(input(f"请输入您要存款的金额："))
    global money
    money += x
    print(f"您现在的余额为：{money}")
    return menu()
def out():
    y = float(input(f"请输入您要取出的金额："))
    global money
    money -= y
    print(f"您现在的余额为：{money}")
    return menu()
menu()
